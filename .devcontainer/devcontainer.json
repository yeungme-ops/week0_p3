{
  "name": "AISCI 210 — Getting Started",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  },
  "postCreateCommand": "python3 -m venv .venv && .venv/bin/python -m pip install -r requirements.txt"
}